# ============================================================================
# ReadSync 环境变量配置
#
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都有合理默认值，最小情况下只需要设置 READSYNC_BASE_URL。
# ============================================================================

# ---------------------------- 基础 ----------------------------

# 运行环境：development | production | test
NODE_ENV=production

# 监听端口与地址。容器内必须是 0.0.0.0 才能被外部访问
READSYNC_PORT=3000
READSYNC_HOST=0.0.0.0

# ★ 对外访问地址。用于生成邮件里的重置链接、WebAuthn 通行密钥的 origin 校验。
#   部署到公网时务必改成真实地址（含协议与端口），否则通行密钥无法使用。
READSYNC_BASE_URL=http://localhost:3000

# 数据目录：数据库、RSA 私钥、主密钥、上传缓存、插件、本地存储都在这里
# 备份时备份整个目录即可
READSYNC_DATA_DIR=./data

# 分片上传的**初始**分片大小（字节），默认 4 MiB。
# 网页端上传书籍走分片，每个请求只有这么大 —— 这正是能穿过 Nginx
# client_max_body_size、Cloudflare 橙云/Tunnel 体积与超时限制的原因。
#
# 一般不用改：前端会在遇到 524/504/413 这类「片太大传不完」的错误时**自动减半重试**
# （4 MiB → 2 → 1 → 512 → 256 KiB），因此慢链路会自己降到合适的大小。
# 这里设置的是起点；上行普遍很慢的话可以调低，省掉几次重试。
# 允许范围 256 KiB ~ 64 MiB，超出会被夹到边界值。
# READSYNC_UPLOAD_CHUNK_SIZE=4194304

# ---------------------------- 安全 ----------------------------

# 主密钥：用于加密存储后端凭据（WebDAV 密码、S3 SecretKey）与邮件 API Key。
# 留空则首次启动自动生成并写入 {DATA_DIR}/secret.key。
# ⚠ 一旦设置后请勿更改，否则已保存的凭据将无法解密；请与数据目录一同备份。
# 生成方法：openssl rand -base64 48
READSYNC_SECRET=

# 是否信任反向代理的 X-Forwarded-* 头（用于获取真实客户端 IP）。
# 仅当服务确实部署在 Nginx / Caddy / Traefik 之后时才设为 true，
# 否则客户端可以伪造 IP 绕过登录限流。
READSYNC_TRUST_PROXY=false

# 允许的跨域来源，逗号分隔。留空表示不限制（前端由本服务托管时无需设置）
READSYNC_CORS_ORIGINS=

# 令牌有效期（秒）
READSYNC_ACCESS_TOKEN_TTL=7200
READSYNC_REFRESH_TOKEN_TTL=2592000
READSYNC_REMEMBER_TTL=7776000

# 登录失败限流
READSYNC_LOGIN_MAX_ATTEMPTS=10
READSYNC_LOGIN_WINDOW=900

# 允许密码以明文提交。
#
# 背景：密码加密依赖浏览器的 WebCrypto，而它**只在安全上下文可用**
# （HTTPS，或通过 localhost / 127.0.0.1 访问）。若你只用 http://<内网IP>:3000
# 访问，浏览器不会提供 WebCrypto，前端无法加密 —— 此时：
#   false（默认）→ 前端明确报错并说明解决办法，不会偷偷发明文
#   true         → 前端降级为明文提交，页面上会显示醒目警告
#
# 仅在你确实无法配置 HTTPS、且访问链路可信（内网 / VPN）时才开启。
# 公网部署请改配 HTTPS（如 Cloudflare Tunnel），见 README。
# READSYNC_ALLOW_PLAINTEXT_PASSWORD=true

# ---------------------------- 日志 ----------------------------

# 日志级别：fatal | error | warn | info | debug | trace | silent
READSYNC_LOG_LEVEL=info

# 是否输出彩色可读日志（开发用）。生产环境建议 false 以输出 JSON 便于采集
READSYNC_LOG_PRETTY=false

# ---------------------------- 其它 ----------------------------

# 启动时自动执行数据库迁移
READSYNC_AUTO_MIGRATE=true

# 是否由本服务托管前端静态文件。设为 false 则只提供 API
READSYNC_SERVE_WEB=true

# 插件目录，默认 {DATA_DIR}/plugins
# READSYNC_PLUGIN_DIR=./data/plugins

# 前端构建产物目录，默认 ./packages/web/dist
# READSYNC_WEB_DIST=./packages/web/dist
