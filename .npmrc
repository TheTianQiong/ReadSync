# 国内网络环境加速配置
# npm 包走国内镜像源
registry=https://mirrors.huaweicloud.com/repository/npm/

# 原生模块预编译包走 npmmirror 二进制镜像（默认从 GitHub Releases 下载，国内会失败）
better_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3
sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/sqlite3
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips
node_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/sqlite3

# 关闭审计与赞助信息，加快安装
audit=false
fund=false
