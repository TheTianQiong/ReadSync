# ============================================================================
# ReadSync · Caddy 反向代理（标准 443 端口，域名需已备案）
#
# 用法：
#   sudo cp deploy/https/Caddyfile.standard /etc/caddy/Caddyfile
#   sudo sed -i 's/read.example.com/你的域名/' /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy 会自动申请并续期 Let's Encrypt 证书，并自动完成 HTTP → HTTPS 跳转，
# 因此不需要单独写 80 端口的 server 块。
#
# 前提：
#   - 域名 A 记录已指向本机公网 IP
#   - 80 与 443 可从公网访问（大陆服务器要求域名已 ICP 备案）
# ============================================================================

read.example.com {
	encode zstd gzip

	# 书籍文件可能很大，放宽请求体上限
	request_body {
		max_size 2GB
	}

	reverse_proxy 127.0.0.1:3000 {
		# 传递真实客户端 IP。同时需要把 .env 里的 READSYNC_TRUST_PROXY 设为 true，
		# 否则服务端不会采信这些头，登录限流会按代理 IP 计数，形同虚设。
		# X-Forwarded-For / X-Forwarded-Proto 由 Caddy 默认传递，无需重复声明
		# （显式再写一遍会触发 "Unnecessary header_up" 警告）。
		header_up X-Real-IP {remote_host}

		# 大文件上传/下载不走缓冲，直接透传
		flush_interval -1
	}

	# 同步接口与认证接口不应被缓存
	@no_cache path /api/* /syncs/* /users/*
	header @no_cache Cache-Control "no-store"

	# 服务端已用 helmet 设置安全头，这里只补充与隐藏信息
	header {
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
