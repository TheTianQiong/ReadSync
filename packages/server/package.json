{
  "name": "@readsync/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReadSync 后端服务与 CLI",
  "main": "./dist/index.js",
  "bin": {
    "readsync": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/server": "^14.0.2",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  }
}
