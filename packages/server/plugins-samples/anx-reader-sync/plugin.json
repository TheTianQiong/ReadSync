{
  "id": "com.readsync.anx-reader-sync",
  "name": "安读（Anx Reader）同步",
  "version": "1.0.1",
  "author": "ReadSync",
  "description": "定时读取 WebDAV / S3 上 Anx Reader 的 database7.db，把书架、阅读进度与每日阅读时长导入本服务器。连接信息由每个用户自己填写，数据只会导入填写者自己的账号。",
  "license": "MIT",
  "homepage": "https://github.com/anxcye/anx-reader",
  "apiVersion": ">=0.4.0 <0.5.0",
  "capabilities": ["metadata"],
  "permissions": ["log", "db:plugin", "fs:storage", "sqlite:read", "sync:write", "books:write"],
  "config": [
    {
      "key": "sourceMode",
      "label": "Anx 数据放在哪",
      "type": "select",
      "scope": "user",
      "default": "connect",
      "options": [
        { "value": "connect", "label": "在这里填连接信息（推荐）" },
        { "value": "existing", "label": "复用「存储管理」里我自己的存储" }
      ],
      "description": "Anx Reader 的 WebDAV 备份目录通常与书籍文件存储不是同一个地方，所以可以直接在这里填它自己的地址"
    },
    {
      "key": "storageId",
      "label": "已有存储的 ID",
      "type": "number",
      "scope": "user",
      "showWhen": { "key": "sourceMode", "equals": "existing" },
      "description": "在「存储管理」里能看到 ID；只能填你自己的存储"
    },

    {
      "key": "driver",
      "label": "连接方式",
      "type": "select",
      "scope": "user",
      "default": "webdav",
      "showWhen": { "key": "sourceMode", "equals": "connect" },
      "options": [
        { "value": "webdav", "label": "WebDAV（坚果云 / Nextcloud / Alist…）" },
        { "value": "s3", "label": "S3 兼容对象存储（R2 / OSS / COS / MinIO）" },
        { "value": "local", "label": "服务器本地目录" }
      ]
    },

    {
      "key": "webdavUrl",
      "label": "WebDAV 地址",
      "type": "url",
      "scope": "user",
      "placeholder": "https://dav.jianguoyun.com/dav/",
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "要填到能直接列目录的那一层"
    },
    {
      "key": "webdavUsername",
      "label": "WebDAV 用户名",
      "type": "string",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "webdav" }
    },
    {
      "key": "webdavPassword",
      "label": "WebDAV 密码 / 应用授权码",
      "type": "password",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "加密存储，其他用户与管理员都看不到；坚果云这类服务要用「应用密码」而不是登录密码"
    },
    {
      "key": "webdavBasePath",
      "label": "WebDAV 根目录",
      "type": "string",
      "scope": "user",
      "default": "/",
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "留空或 / 表示账号根目录"
    },
    {
      "key": "webdavAllowSelfSigned",
      "label": "允许自签名证书",
      "type": "boolean",
      "scope": "user",
      "default": false,
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "自建 Nextcloud / Alist 常见"
    },

    {
      "key": "s3Endpoint",
      "label": "S3 Endpoint",
      "type": "url",
      "scope": "user",
      "placeholder": "https://s3.example.com",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3Bucket",
      "label": "S3 存储桶",
      "type": "string",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3Region",
      "label": "S3 区域",
      "type": "string",
      "scope": "user",
      "default": "us-east-1",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3AccessKeyId",
      "label": "S3 Access Key",
      "type": "password",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3SecretAccessKey",
      "label": "S3 Secret Key",
      "type": "password",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "s3" },
      "description": "与 Access Key 一样加密存储"
    },
    {
      "key": "s3Prefix",
      "label": "S3 对象前缀",
      "type": "string",
      "scope": "user",
      "default": "",
      "showWhen": { "key": "driver", "equals": "s3" },
      "description": "Anx 备份目录在桶里的位置；留空表示桶根目录"
    },
    {
      "key": "s3ForcePathStyle",
      "label": "使用 path 风格寻址",
      "type": "boolean",
      "scope": "user",
      "default": true,
      "showWhen": { "key": "driver", "equals": "s3" },
      "description": "阿里云 OSS / MinIO 需要打开；Cloudflare R2 关掉即可"
    },

    {
      "key": "localPath",
      "label": "本地目录",
      "type": "string",
      "scope": "user",
      "default": "anx",
      "showWhen": { "key": "driver", "equals": "local" },
      "description": "相对服务器数据目录下的 storage 目录；例如 anx 表示 <数据目录>/storage/anx"
    },

    {
      "key": "rootPath",
      "label": "Anx 备份根目录",
      "type": "string",
      "scope": "user",
      "default": "",
      "placeholder": "留空表示上面那个位置的根",
      "description": "该目录下应当有 database7.db 和 data 文件夹"
    },
    {
      "key": "dbPath",
      "label": "数据库文件名",
      "type": "string",
      "scope": "user",
      "default": "database7.db",
      "description": "Anx Reader 的数据库；升级大版本时文件名里的数字会变（database7.db → database8.db）"
    },
    {
      "key": "assetDir",
      "label": "资源目录名",
      "type": "string",
      "scope": "user",
      "default": "data",
      "description": "存放封面与原书的子目录；数据库里的 cover_path 是相对于它的"
    },
    {
      "key": "utcOffsetHours",
      "label": "时间戳时区偏移（小时）",
      "type": "number",
      "scope": "user",
      "default": 8,
      "description": "Anx 的 create_time / update_time 是本地时间且不带时区，按这个偏移换算成本地时刻"
    },

    {
      "key": "autoRegisterBooks",
      "label": "自动登记缺失的书目",
      "type": "boolean",
      "scope": "user",
      "default": true,
      "description": "把 Anx 书架里的书建进书库；关闭后只导入已在库中的书"
    },
    {
      "key": "importReadingTime",
      "label": "导入阅读时长",
      "type": "boolean",
      "scope": "user",
      "default": true
    },
    {
      "key": "importCovers",
      "label": "从 Anx 的封面目录取封面",
      "type": "boolean",
      "scope": "user",
      "default": true
    },

    {
      "key": "skipUnchanged",
      "label": "数据库未变化时跳过",
      "type": "boolean",
      "default": true,
      "description": "先比一次 database7.db 的 MD5，一样就不解析；定时跑得勤时能省下大部分开销"
    },
    {
      "key": "intervalMinutes",
      "label": "自动导入间隔（分钟）",
      "type": "number",
      "default": 60,
      "description": "全站统一节奏，由管理员设定（默认 1 小时）；填 0 表示只在手动触发时导入"
    },
    {
      "key": "dailyAt",
      "label": "每日固定同步时间",
      "type": "string",
      "default": "08:00",
      "placeholder": "08:00",
      "description": "Anx 也会轮转/清理旧数据，所以每天这个点再完整同步一次；留空关闭"
    }
  ]
}
