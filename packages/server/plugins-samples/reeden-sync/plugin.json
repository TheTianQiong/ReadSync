{
  "id": "com.readsync.reeden-sync",
  "name": "Reeden 同步",
  "version": "1.2.0",
  "author": "ReadSync",
  "description": "定时读取 WebDAV / S3 上 Reeden 的阅读数据（进度、时长、书目、封面）并导入本服务器。连接信息由每个用户自己填写，数据只会导入填写者自己的账号。",
  "license": "MIT",
  "apiVersion": ">=0.3.0 <0.4.0",
  "capabilities": ["metadata"],
  "permissions": ["log", "db:plugin", "fs:storage", "sync:write", "books:write"],
  "config": [
    {
      "key": "sourceMode",
      "label": "Reeden 数据放在哪",
      "type": "select",
      "scope": "user",
      "default": "connect",
      "options": [
        { "value": "connect", "label": "在这里填连接信息（推荐）" },
        { "value": "existing", "label": "复用「存储管理」里我自己的存储" }
      ],
      "description": "Reeden 的同步目录通常与书籍文件存储不是同一个地方，所以可以直接在这里填它自己的地址"
    },
    {
      "key": "storageId",
      "label": "已有存储的 ID",
      "type": "number",
      "scope": "user",
      "showWhen": { "key": "sourceMode", "equals": "existing" },
      "description": "在「存储管理」里能看到 ID；只能填你自己的存储"
    },

    {
      "key": "driver",
      "label": "连接方式",
      "type": "select",
      "scope": "user",
      "default": "webdav",
      "showWhen": { "key": "sourceMode", "equals": "connect" },
      "options": [
        { "value": "webdav", "label": "WebDAV（坚果云 / Nextcloud / Alist…）" },
        { "value": "s3", "label": "S3 兼容对象存储（R2 / OSS / COS / MinIO）" },
        { "value": "local", "label": "服务器本地目录" }
      ]
    },

    {
      "key": "webdavUrl",
      "label": "WebDAV 地址",
      "type": "url",
      "scope": "user",
      "placeholder": "https://dav.jianguoyun.com/dav/",
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "要填到能直接列目录的那一层"
    },
    {
      "key": "webdavUsername",
      "label": "WebDAV 用户名",
      "type": "string",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "webdav" }
    },
    {
      "key": "webdavPassword",
      "label": "WebDAV 密码 / 应用授权码",
      "type": "password",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "加密存储，其他用户与管理员都看不到；坚果云这类服务要用「应用密码」而不是登录密码"
    },
    {
      "key": "webdavBasePath",
      "label": "WebDAV 根目录",
      "type": "string",
      "scope": "user",
      "default": "/",
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "留空或 / 表示账号根目录"
    },
    {
      "key": "webdavAllowSelfSigned",
      "label": "允许自签名证书",
      "type": "boolean",
      "scope": "user",
      "default": false,
      "showWhen": { "key": "driver", "equals": "webdav" },
      "description": "自建 Nextcloud / Alist 常见"
    },

    {
      "key": "s3Endpoint",
      "label": "S3 Endpoint",
      "type": "url",
      "scope": "user",
      "placeholder": "https://s3.example.com",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3Bucket",
      "label": "S3 存储桶",
      "type": "string",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3Region",
      "label": "S3 区域",
      "type": "string",
      "scope": "user",
      "default": "us-east-1",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3AccessKeyId",
      "label": "S3 Access Key",
      "type": "password",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "s3" }
    },
    {
      "key": "s3SecretAccessKey",
      "label": "S3 Secret Key",
      "type": "password",
      "scope": "user",
      "showWhen": { "key": "driver", "equals": "s3" },
      "description": "与 Access Key 一样加密存储"
    },
    {
      "key": "s3Prefix",
      "label": "S3 对象前缀",
      "type": "string",
      "scope": "user",
      "default": "",
      "showWhen": { "key": "driver", "equals": "s3" },
      "description": "Reeden 根目录在桶里的位置；留空表示桶根目录"
    },
    {
      "key": "s3ForcePathStyle",
      "label": "使用 path 风格寻址",
      "type": "boolean",
      "scope": "user",
      "default": true,
      "showWhen": { "key": "driver", "equals": "s3" },
      "description": "阿里云 OSS / MinIO 需要打开；Cloudflare R2 关掉即可"
    },

    {
      "key": "localPath",
      "label": "本地目录",
      "type": "string",
      "scope": "user",
      "default": "reeden",
      "showWhen": { "key": "driver", "equals": "local" },
      "description": "相对服务器数据目录下的 storage 目录；例如 reeden 表示 <数据目录>/storage/reeden"
    },

    {
      "key": "rootPath",
      "label": "Reeden 根目录",
      "type": "string",
      "scope": "user",
      "default": "",
      "placeholder": "留空表示上面那个位置的根",
      "description": "该目录下应当有 metadata、book_progress、covers 这三样"
    },
    {
      "key": "progressDir",
      "label": "进度目录名",
      "type": "string",
      "scope": "user",
      "default": "book_progress",
      "description": "不同版本的 Reeden 可能是 book_progress 或 bookprogress"
    },
    {
      "key": "utcOffsetHours",
      "label": "时间戳时区偏移（小时）",
      "type": "number",
      "scope": "user",
      "default": 8,
      "description": "read_record 里 create_at 是 UTC，按这个偏移换算成本地小时；只有 hourly 没覆盖到的早期数据才用得上"
    },

    {
      "key": "autoRegisterBooks",
      "label": "自动登记缺失的书目",
      "type": "boolean",
      "scope": "user",
      "default": true,
      "description": "从 Reeden 的 metadata 里读出书名作者建进书库；关闭后只导入已在库中的书"
    },
    {
      "key": "importReadingTime",
      "label": "导入阅读时长",
      "type": "boolean",
      "scope": "user",
      "default": true
    },
    {
      "key": "importCovers",
      "label": "从 Reeden 的 covers 里取封面",
      "type": "boolean",
      "scope": "user",
      "default": true
    },

    {
      "key": "intervalMinutes",
      "label": "自动导入间隔（分钟）",
      "type": "number",
      "default": 60,
      "description": "全站统一节奏，由管理员设定；填 0 表示只在手动触发时导入"
    },
    {
      "key": "dailyAt",
      "label": "每日固定同步时间",
      "type": "string",
      "default": "23:55",
      "placeholder": "23:55",
      "description": "当天数据在次日可能被轮转掉，所以每天这个点再补一次；留空关闭"
    }
  ]
}
